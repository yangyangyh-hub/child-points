/* 我的页样式

   设计要点:
     1) 名片不做成大横幅 —— 这一页的重要信息是「入口」,不是身份展示
     2) 数据概览四格,用语义色区分(可用蓝 / 累计绿 / 连续中性 / 勋章橙)
        —— 一眼能分辨哪个数字代表什么,不用读标签
     3) 菜单项图标用 emoji 而非图片:省流量、不增加包体,且色调统一 */

.page {
  padding-top: 24rpx;
  /* 自定义 tabBar 是 fixed 定位、不占布局流 ⇒ 留出高度 + 安全区,否则最后一项被盖住 */
  padding-bottom: calc(136rpx + env(safe-area-inset-bottom));
}

/* ============ 名片 ============ */

.profile-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 32rpx 40rpx;
}

.profile-avatar {
  width: 144rpx;
  height: 144rpx;
  border-radius: 72rpx;
  background: linear-gradient(135deg, var(--cp-primary-soft) 0%, #CFE4FD 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
  font-weight: 700;
  color: var(--cp-primary);
  overflow: hidden;
}

/* 家长模式头像换暖色,一眼看出身份不同 */
.profile-avatar-parent {
  background: linear-gradient(135deg, #FFF1D6 0%, #FFE0A8 100%);
  color: var(--cp-warn-deep);
}

.profile-avatar-img { width: 100%; height: 100%; }

.profile-name {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--cp-text);
  margin-top: 22rpx;
}

.profile-meta {
  font-size: 25rpx;
  color: var(--cp-text-sub);
  margin-top: 8rpx;
}

.profile-meta .dot { margin: 0 10rpx; }

.profile-mode-btn {
  margin-top: 30rpx;
  min-width: 320rpx;
  height: 80rpx;
  border-radius: 40rpx;
  background: var(--cp-primary-soft);
  color: var(--cp-primary);
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.profile-mode-btn-parent {
  background: var(--cp-warn-soft);
  color: var(--cp-warn-deep);
}

/* ============ 数据概览 ============ */

.stat-card { padding: 30rpx 12rpx; }

.stat-row { display: flex; }

.stat-cell {
  flex: 1;
  text-align: center;
  min-width: 0;
}

.stat-value {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--cp-text);
  line-height: 1.2;
}

.stat-label {
  font-size: 22rpx;
  color: var(--cp-text-sub);
  margin-top: 6rpx;
}

/* ============ 菜单 ============ */

.menu-card { padding: 8rpx 26rpx; }

.menu-item {
  display: flex;
  align-items: center;
  padding: 26rpx 0;
}

.menu-item + .menu-item {
  border-top: 1rpx solid var(--cp-surface);
}

.menu-icon {
  font-size: 42rpx;
  width: 68rpx;
  flex-shrink: 0;
  text-align: center;
}

.menu-body {
  flex: 1;
  min-width: 0;
  padding: 0 12rpx;
}

.menu-name {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--cp-text);
}

.menu-sub {
  font-size: 23rpx;
  color: var(--cp-text-sub);
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.menu-arrow {
  font-size: 40rpx;
  color: #C9D4DE;
  flex-shrink: 0;
  line-height: 1;
}
