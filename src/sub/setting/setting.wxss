/* 设置页样式

   设计要点:
     1) 每个设置项配一句"这是什么、为什么"——设置页最容易做成
        只有开关没有解释的界面,家长会不敢动
     2) 「重置」按钮用浅暖色块而不是大红,且配完整说明
        —— 危险操作不该靠视觉吸引去点,但不该藏起来
     3) 头像按钮用 open-type=chooseAvatar,所以是 button 元素
        需要清掉 button 默认样式 */

.page { padding-top: 16rpx; }

/* ============ 头像 ============ */

.avatar-row {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
}

.avatar-btn {
  width: 140rpx;
  height: 140rpx;
  padding: 0;
  margin: 0;
  border-radius: 70rpx;
  background: var(--cp-bg);
  overflow: hidden;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  border: none;
}

.avatar-btn::after { border: none; }

.avatar-img { width: 100%; height: 100%; }

.avatar-ph {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.avatar-ph-icon { font-size: 46rpx; }

.avatar-ph-text {
  font-size: 20rpx;
  color: var(--cp-text-sub);
  margin-top: 6rpx;
}

.avatar-tip {
  flex: 1;
  min-width: 0;
  font-size: 23rpx;
  color: var(--cp-text-sub);
  line-height: 1.5;
  padding-left: 24rpx;
}

/* ============ 表单件 ============ */

.field { margin-bottom: 26rpx; }

.field-label {
  font-size: 27rpx;
  color: var(--cp-text-sub);
  margin-bottom: 12rpx;
}

.field-input {
  height: 88rpx;
  background: var(--cp-bg);
  border-radius: 20rpx;
  padding: 0 26rpx;
  font-size: 30rpx;
  color: var(--cp-text);
}

.picker-box {
  height: 88rpx;
  background: var(--cp-bg);
  border-radius: 20rpx;
  padding: 0 26rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 30rpx;
  color: var(--cp-text);
}

.picker-arrow {
  font-size: 36rpx;
  color: #C9D4DE;
  line-height: 1;
}

/* ============ 设置项 ============ */

.item-name {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--cp-text);
}

.item-sub {
  font-size: 23rpx;
  color: var(--cp-text-sub);
  margin-top: 6rpx;
  line-height: 1.5;
}

.item-note {
  font-size: 21rpx;
  color: var(--cp-text-hint);
  line-height: 1.7;
  margin-top: 20rpx;
}
